# ---- Bioinformatics data files ----
# Never commit large data. If you need example data, put it in tests/data/
# and keep it under ~100KB.
*.bam
*.bai
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.h5
*.hdf5
!tests/data/*.h5      # exception: tiny test fixtures are OK

